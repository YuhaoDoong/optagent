# Copy to `.env` and fill in. `.env` is gitignored; `.env.example` is committed.
# Any value already exported in your shell takes precedence over `.env`.

# --- LLM providers (any ONE enables --enable-llm / the chat tab) ---
# OpenRouter is a multi-model gateway (OpenAI-compatible API). Preferred when set.
OPENROUTER_API_KEY=
# Pick any OpenRouter model slug. Default: anthropic/claude-sonnet-4.6
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
# Optional OpenRouter ranking headers:
# OPENROUTER_REFERER=https://github.com/YuhaoDoong/optagent
# OPENROUTER_TITLE=optagent

# Single-vendor keys (used if OPENROUTER_API_KEY is unset):
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# --- Optional data adapters ---
# FRED_API_KEY=
# OPTAGENT_USER_AGENT=optagent/0.x (you@example.com)
